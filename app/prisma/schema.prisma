generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Node {
  id              String   @id // e.g. "STAS", "CTR"
  label           String
  type            String   // "factor" | "outcome" | "evidence" | "guideline"
  x               Float
  y               Float
  description     String?  
  nameZh          String?
  nameEn          String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sourceEdges     Edge[]   @relation("SourceEdges")
  targetEdges     Edge[]   @relation("TargetEdges")
  patientQuestions PatientQuestion[]
}

model PatientQuestion {
  id          String @id @default(uuid())
  nodeId      String
  question    String
  answer      String 
  
  node        Node   @relation(fields: [nodeId], references: [id], onDelete: Cascade)
}

model Edge {
  id               String   @id @default(uuid())
  sourceNodeId     String
  targetNodeId     String
  relationshipType String   // "risk" | "protective" | "guides"
  
  sourceNode       Node     @relation("SourceEdges", fields: [sourceNodeId], references: [id])
  targetNode       Node     @relation("TargetEdges", fields: [targetNodeId], references: [id])

  evidence         EdgeEvidence?
  studies          EdgeStudy[]
  forestData       ForestData[]

  @@unique([sourceNodeId, targetNodeId])
}

model EdgeEvidence {
  id           String @id @default(uuid())
  edgeId       String @unique
  title        String
  description  String 
  
  metricLabel  String?
  metricValue  String?
  metricCi     String?
  metricP      String?
  
  confidenceRating String? // e.g., "⭐⭐⭐⭐☆"
  confidenceLevel  String? // e.g., "High", "Moderate"
  source           String?
  clinicalImpact   String? 

  edge         Edge   @relation(fields: [edgeId], references: [id], onDelete: Cascade)
}

model Study {
  id             String      @id @default(uuid())
  doi            String?     @unique
  title          String
  journal        String?
  publishedYear  Int?
  conclusion     String?     
  
  edges          EdgeStudy[]
}

model EdgeStudy {
  edgeId   String
  studyId  String

  edge     Edge  @relation(fields: [edgeId], references: [id], onDelete: Cascade)
  study    Study @relation(fields: [studyId], references: [id], onDelete: Cascade)

  @@id([edgeId, studyId])
}

model ForestData {
  id          String @id @default(uuid())
  edgeId      String
  studyName   String
  year        Int?
  hr          Float
  ciLow       Float
  ciHigh      Float

  edge        Edge   @relation(fields: [edgeId], references: [id], onDelete: Cascade)
}

model PatientProfile {
  id                  String   @id @default(uuid())
  userId              String?  // Optional, for future auth
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  // Patient Demo
  age                 Int?
  sex                 String?
  
  // Disease
  organ               String?  @default("lung")
  histology           String?
  
  // Imaging
  noduleType          String?
  sizeMm              Float?
  ctr                 Float?
  
  // Pathology
  tumorSize           Float?
  grade               String?
  tStage              String?
  nStage              String?
  mStage              String?
  stas                Boolean?
  vpi                 Boolean?
  lvi                 Boolean?
  
  // Treatment
  surgeryType         String?
  marginStatus        String?
  
  // State Engine (Dynamic Decision Nodes)
  currentStage        String?
  riskLevel           String?
  nextAction          String?
  psychologicalState  String?
}

model ClinicalCohort {
  id               String   @id @default(uuid())
  name             String
  cohortSize       Int
  rfs5Year         String
  os5Year          String
  confidenceRating String
  confidenceLevel  String
  source           String
  description      String   
  matchCriteria    String   
  createdAt        DateTime @default(now())
}

model IngestedStudy {
  id               String   @id @default(uuid())
  title            String
  journal          String?
  year             Int?
  authors          String?
  studyType        String?  // "rct" | "meta_analysis" | "prospective_multicenter" | "retrospective"
  evidenceLevel    Int?     @default(4)
  patientN         Int?
  doi              String?
  pubmedId         String?
  applicableStages String?  // JSON string e.g. ["IA", "IB", "IIIA"]
  relevantFactors  String?  // JSON string e.g. ["STAS", "EGFR"]
  summary          String?
  conclusion       String?
  keywords         String?
  hr               Float?
  ciLow            Float?
  ciHigh           Float?
  rfs5Year         String?
  biomarkerDetails String?  // 分子亚型与生物标志物 (如 "EGFR 19del/L858R", "PD-L1 TPS>=50%")
  interventionArm  String?  // 治疗干预组 vs 对照组 (如 "奥希替尼 80mg vs 安慰剂")
  riskReduction    String?  // 风险降低率 (如 "-77% (HR=0.23)")
  pdfFileName      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}